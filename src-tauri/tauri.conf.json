{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "huajian-infinity",
  "mainBinaryName": "huajian-infinity",
  "version": "0.6.1-beta",
  "identifier": "com.huajian.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "花笺infinity",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "linux": {
      "deb": {
        "desktopTemplate": "huajian-infinity.desktop.template",
        "files": {
          "/usr/share/doc/huajian-infinity/copyright": "licenses/MulanPSL2.0.txt"
        }
      }
    },
    "category": "Utility",
    "license": "MulanPSL-2.0",
    "licenseFile": "licenses/MulanPSL2.0.txt",
    "copyright": "Copyright (c) 2026 huajian",
    "shortDescription": "花笺infinity — 所见即所得 Markdown 笔记",
    "longDescription": "花笺infinity：基于花匣(.hxl)打包的所见即所得 Markdown 笔记应用。用户数据保存于 ~/.config/com.huajian.app/。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["hxl"],
        "name": "huajian-box",
        "description": "花匣笔记包",
        "mimeType": "application/x-huajian-box"
      }
    ]
  }
}
